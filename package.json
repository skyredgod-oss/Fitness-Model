{
  "name": "walailak-fitness",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -k -n API,WEB \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "build": "npm run build -w backend && npm run build -w frontend",
    "start": "npm run start -w backend",
    "db:generate": "npm run db:generate -w backend",
    "db:migrate": "npm run db:migrate -w backend",
    "db:seed": "npm run db:seed -w backend",
    "admin:create": "npm run admin:create -w backend",
    "test": "npm run test -w backend",
    "test:e2e": "playwright test",
    "setup": "node scripts/init-env.mjs && npm run db:generate && npm run db:migrate && npm run db:seed"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "concurrently": "^9.2.1",
    "prettier": "^3.9.10"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "effect": "^3.22.4",
    "deepmerge-ts": "^8.0.2"
  }
}
